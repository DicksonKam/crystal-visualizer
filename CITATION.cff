    given-names: Dickson
version: 1.0.0
date-released: 2026-11-07
license: MIT
repository-code: "https://github.com/DicksonKam/crystal-visualizer"
url: "https://dicksonkam.github.io/crystal-visualizer/"
keywords:
  - crystallography
  - materials science
  - VASP
  - CIF
  - POSCAR
  - XDATCAR
  - XYZ
  - visualization
  - three.js
